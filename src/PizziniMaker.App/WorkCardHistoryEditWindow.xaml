<Window x:Class="PizziniMaker.App.WorkCardHistoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PizziniMaker;component/Assets/PizziniMaker.ico"
        Title="Scheda" Width="400" MinWidth="320" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="22">
        <TextBlock Text="Numero scheda (4 cifre)" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBox x:Name="NumberTextBox" MaxLength="4" Width="100" HorizontalAlignment="Left" Margin="0,5,0,14" Padding="7,5"
                 PreviewTextInput="Number_PreviewTextInput"/>
        <TextBlock Text="Commento" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBox x:Name="CommentTextBox" MaxLength="60" Margin="0,5,0,18" Padding="7,5"/>
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="Annulla" MinWidth="90" Margin="0,0,8,0" Padding="12,6" IsCancel="True"/>
            <Button Content="Salva" MinWidth="90" Padding="12,6" IsDefault="True" Click="Save_Click"
                    Background="#2F6F4E" Foreground="White" BorderBrush="#2F6F4E"/>
        </WrapPanel>
    </StackPanel>
</Window>
