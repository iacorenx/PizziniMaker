<Window x:Class="PizziniMaker.App.MonthlyCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PizziniMaker;component/Assets/PizziniMaker.ico"
        Title="Calendario mensile - PizziniMaker" Width="780" Height="760" MinWidth="700" MinHeight="660"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF" FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="← Mese precedente" Click="PreviousMonth_Click" Padding="10,5"/>
            <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="21" FontWeight="SemiBold" Foreground="#303C32"/>
            <Button Grid.Column="2" Content="Mese successivo →" Click="NextMonth_Click" Padding="10,5"/>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,12,0,4">
            <TextBlock Text="Lunedì" TextAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text="Martedì" TextAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text="Mercoledì" TextAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text="Giovedì" TextAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text="Venerdì" TextAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text="Sabato" TextAlignment="Center" Foreground="#777168"/>
            <TextBlock Text="Domenica" TextAlignment="Center" Foreground="#A74716"/>
        </UniformGrid>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="2" Padding="5" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}"
                            BorderThickness="{Binding CellBorderThickness}" ToolTip="{Binding ToolTip}"
                            IsEnabled="{Binding HasDate}" Click="Day_Click" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="{Binding DayNumber}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding NumberBrush}"/>
                                <TextBlock Text="{Binding LockText}" HorizontalAlignment="Right" FontFamily="Segoe UI Emoji"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding Icons}" TextWrapping="Wrap" FontFamily="Segoe UI Emoji"
                                       FontSize="15" VerticalAlignment="Center" Foreground="#2F6F4E"/>
                            <TextBlock Grid.Row="2" Text="{Binding HoursText}" HorizontalAlignment="Right"
                                       FontSize="10" Foreground="#6C665B"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="3" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Legenda:" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Foreground="#6C665B" TextWrapping="Wrap"
                       Text="verde = completo · arancione = incompleto · rosso = festività · 🔒 = forzatura richiesta · 🚗 = viaggio · 🧳 = trasferta · ⚠ = infortunio · € = straordinario"/>
        </Grid>
        <Border Grid.Row="4" Background="#F3EEE3" BorderBrush="#D8CEBC" BorderThickness="1" Padding="12" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding LeaveSummary}" Margin="0,3,8,3" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="{Binding SickSummary}" Margin="8,3,0,3" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="{Binding OvertimeSummary}" Margin="0,3,8,3" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TravelSummary}" Margin="8,3,0,3" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Text="{Binding TrasfertaSummary}" Margin="0,3,8,3" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MissingSummary}" Margin="8,3,0,3" Foreground="#A74716" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Text="{Binding InjurySummary}" Margin="0,3,8,3" TextWrapping="Wrap"/>
                <Button Grid.Row="4" Grid.Column="1" Content="Apri giorni mancanti" Click="MissingDays_Click"
                        HorizontalAlignment="Right" Padding="10,4" Margin="0,5,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
