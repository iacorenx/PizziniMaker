<Window x:Class="PizziniMaker.App.OvertimeConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PizziniMaker;component/Assets/PizziniMaker.ico"
        Title="Conferma straordinario" Width="420" Height="225" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Straordinario presente" FontSize="21" FontWeight="SemiBold" Foreground="#8D3D12"/>
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,12,0,8" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Text="La quantità sarà indicata nel log e nel calendario mensile con il simbolo €€."
                   TextWrapping="Wrap" Foreground="#6C665B"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annulla" Width="95" Margin="0,0,8,0" Padding="8,6" IsCancel="True"/>
            <Button Content="Conferma e chiudi" Click="Confirm_Click" Padding="12,6"
                    Background="#2F6F4E" Foreground="White" BorderBrush="#2F6F4E"/>
        </StackPanel>
    </Grid>
</Window>
