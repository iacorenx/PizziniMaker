<Window x:Class="PizziniMaker.App.OvertimeConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PizziniMaker;component/Assets/PizziniMaker.ico"
        Title="Conferma straordinario" Width="440" MinWidth="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="22">
        <TextBlock x:Name="HeaderText" Text="Straordinario presente" FontSize="21" FontWeight="SemiBold"
                   Foreground="#8D3D12" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Margin="0,12,0,8" TextWrapping="Wrap"/>
        <TextBlock x:Name="HintText" Text="La quantità sarà indicata nel log e, con il simbolo €, nel calendario mensile."
                   TextWrapping="Wrap" Foreground="#6C665B"/>
        <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annulla" MinWidth="95" Margin="0,0,8,0" Padding="12,6" IsCancel="True"/>
            <Button Content="Conferma e chiudi" Click="Confirm_Click" MinWidth="95" Padding="12,6" IsDefault="True"
                    Background="#2F6F4E" Foreground="White" BorderBrush="#2F6F4E"/>
        </WrapPanel>
    </StackPanel>
</Window>
