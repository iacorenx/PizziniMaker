<Window x:Class="PizziniMaker.App.MissingDaysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giorni da compilare" Width="380" Height="420"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Giorni precedenti da compilare" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,14" Foreground="#6C665B" TextWrapping="Wrap"
                   Text="Sono inclusi solo i giorni lavorativi successivi alla data di inizio controllo."/>
        <ListBox x:Name="DaysList" Grid.Row="2" Padding="4" BorderBrush="#D8CEBC"
                 MouseDoubleClick="DaysList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" Padding="8,7"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Chiudi" Width="90" Margin="0,0,8,0" Padding="8,6" IsCancel="True"/>
            <Button Content="Apri giorno" Width="110" Padding="8,6" IsDefault="True" Click="Open_Click"
                    Background="#2F6F4E" Foreground="White" BorderBrush="#2F6F4E"/>
        </StackPanel>
    </Grid>
</Window>
