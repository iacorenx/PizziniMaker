<Window x:Class="PizziniMaker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PizziniMaker;component/Assets/PizziniMaker.ico"
        Title="Impostazioni - PizziniMaker" Width="440" Height="460" MinHeight="410" MinWidth="400"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Impostazioni" FontSize="22" FontWeight="SemiBold" Foreground="#3D392F"/>
                <TextBlock Margin="0,8,0,18" TextWrapping="Wrap" Foreground="#6C665B"
                           Text="I dati restano nella cartella portabile dell'applicazione."/>
                <TextBlock Text="Nome del dipendente" FontWeight="SemiBold"/>
                <TextBox x:Name="EmployeeTextBox" Margin="0,5,0,14" Padding="8,6" MaxLength="100"/>
                <TextBlock Text="Controlla i giorni mancanti a partire da" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <DatePicker x:Name="TrackingDatePicker" Margin="0,5,0,16" Padding="5,4"/>
                <CheckBox x:Name="TopmostCheckBox" Margin="0,3">
                    <TextBlock Text="Finestra sempre in primo piano" TextWrapping="Wrap"/>
                </CheckBox>
                <CheckBox x:Name="StartupCheckBox" Margin="0,10,0,6">
                    <TextBlock Text="Avvia PizziniMaker con Windows" TextWrapping="Wrap"/>
                </CheckBox>
                <Border Margin="0,16,0,4" Padding="10" Background="#F3EEE3" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="Attività personalizzate" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CustomActivitiesSummary" Margin="0,4,0,8" TextWrapping="Wrap" Foreground="#6C665B"/>
                        <Button Content="Gestisci attività personalizzate..." Click="ManageActivities_Click"
                                Padding="8,5" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annulla" Width="90" Margin="0,0,8,0" Padding="8,6" IsCancel="True"/>
            <Button Content="Salva" Width="90" Padding="8,6" IsDefault="True" Click="Save_Click"
                    Background="#2F6F4E" Foreground="White" BorderBrush="#2F6F4E"/>
        </StackPanel>
    </Grid>
</Window>
