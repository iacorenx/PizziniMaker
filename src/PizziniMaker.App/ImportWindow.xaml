<Window x:Class="PizziniMaker.App.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PizziniMaker;component/Assets/PizziniMaker.ico"
        Title="Importa dati - PizziniMaker" Width="540" Height="560" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Text="Importa dati da una versione precedente" FontSize="20" FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="SourceText" Grid.Row="1" Margin="0,7,0,10" TextWrapping="Wrap" Foreground="#6C665B"/>
        <Border Grid.Row="2" Background="White" BorderBrush="#D8CEBC" BorderThickness="1" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DetailsText" Margin="12,10" TextWrapping="Wrap" LineHeight="20" FontFamily="Segoe UI, Segoe UI Emoji"/>
            </ScrollViewer>
        </Border>
        <StackPanel x:Name="OptionsPanel" Grid.Row="3" Margin="0,12,0,0">
            <CheckBox x:Name="ImportSettingsCheckBox" IsChecked="False">
                <TextBlock x:Name="ImportSettingsLabel" TextWrapping="Wrap"
                           Text="Importa anche le attività personalizzate e la data di inizio controllo (se precedente)"/>
            </CheckBox>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#6C665B" FontSize="12"
                       Text="Prima dell'importazione viene creato un backup ZIP dei dati attuali nella cartella Backup. La cartella di origine non viene modificata."/>
        </StackPanel>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Annulla" MinWidth="90" Margin="0,0,8,0" Padding="12,6" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="Importa" MinWidth="100" Padding="12,6" Click="Confirm_Click"
                    Background="#2F6F4E" Foreground="White" BorderBrush="#2F6F4E"/>
        </WrapPanel>
    </Grid>
</Window>
