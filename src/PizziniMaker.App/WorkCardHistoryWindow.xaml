<Window x:Class="PizziniMaker.App.WorkCardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PizziniMaker;component/Assets/PizziniMaker.ico"
        Title="Storico schede - PizziniMaker" Width="500" Height="540" MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Storico schede" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,10" TextWrapping="Wrap" Foreground="#6C665B"
                   Text="Le schede delle giornate confermate vengono aggiunte automaticamente. Schede, mandati e preventivi: ogni numero ha un solo commento, proposto mentre scrivi nella riga."/>
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <TextBox x:Name="SearchTextBox" Padding="7,5" TextChanged="Search_TextChanged"
                     ToolTip="Cerca per numero o commento"/>
            <TextBlock Text="Cerca per numero o commento…" IsHitTestVisible="False" Margin="10,0,0,0"
                       VerticalAlignment="Center" Foreground="#A39B8C" FontStyle="Italic">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <ListBox x:Name="EntriesList" Grid.Row="3" BorderBrush="#D8CEBC" MouseDoubleClick="EntriesList_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding CommentText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding UsageText}" FontSize="11" Foreground="#7B7468" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <Button Content="Aggiungi" Click="Add_Click" Padding="12,5" Margin="0,0,7,4"/>
            <Button Content="Modifica" Click="Edit_Click" Padding="12,5" Margin="0,0,7,4"/>
            <Button Content="Elimina" Click="Delete_Click" Padding="12,5" Margin="0,0,7,4"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#7B7468" Margin="4,0,0,4"/>
        </WrapPanel>
        <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annulla" MinWidth="90" Margin="0,0,8,0" Padding="12,6" IsCancel="True"/>
            <Button Content="Salva" MinWidth="90" Padding="12,6" Click="Confirm_Click"
                    Background="#2F6F4E" Foreground="White" BorderBrush="#2F6F4E"/>
        </WrapPanel>
    </Grid>
</Window>
