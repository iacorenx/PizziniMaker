<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PizziniMaker.Core\PizziniMaker.Core.csproj" />
    <Resource Include="Assets\PizziniMaker.ico" />
    <Resource Include="Assets\PizziniMaker.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- PDFsharp: fissato alla 6.2.4, ultima versione con licenza MIT (dalla 6.5 è AGPL). -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PizziniMaker</AssemblyName>
    <Version>1.4.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Registro giornaliero portabile delle ore lavorative.</Description>
    <ApplicationIcon>Assets\PizziniMaker.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
