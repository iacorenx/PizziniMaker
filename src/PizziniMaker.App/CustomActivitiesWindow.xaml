<Window x:Class="PizziniMaker.App.CustomActivitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PizziniMaker;component/Assets/PizziniMaker.ico"
        Title="Attività personalizzate" Width="450" Height="440" MinHeight="350"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Attività personalizzate" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,12" TextWrapping="Wrap" Foreground="#6C665B"
                   Text="Le modifiche valgono per le nuove righe. Le attività già inserite nei giorni precedenti restano invariate."/>
        <ListBox x:Name="ActivitiesList" Grid.Row="2" BorderBrush="#D8CEBC">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="6,5">
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Aggiungi" Click="Add_Click" Padding="10,5" Margin="0,0,7,0"/>
            <Button Content="Modifica" Click="Edit_Click" Padding="10,5" Margin="0,0,7,0"/>
            <Button Content="Elimina" Click="Delete_Click" Padding="10,5"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annulla" Width="90" Margin="0,0,8,0" Padding="8,6" IsCancel="True"/>
            <Button Content="Conferma" Width="100" Padding="8,6" IsDefault="True" Click="Confirm_Click"
                    Background="#2F6F4E" Foreground="White" BorderBrush="#2F6F4E"/>
        </StackPanel>
    </Grid>
</Window>
