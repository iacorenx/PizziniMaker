<Window x:Class="PizziniMaker.App.ExpensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PizziniMaker;component/Assets/PizziniMaker.ico"
        Title="Note spese - PizziniMaker" Width="700" Height="560" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="←" Width="32" Click="PreviousMonth_Click" ToolTip="Mese precedente"/>
            <TextBlock x:Name="MonthText" Grid.Column="1" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="2" Content="→" Width="32" Click="NextMonth_Click" ToolTip="Mese successivo"/>
        </Grid>
        <CheckBox x:Name="DayOnlyCheckBox" Grid.Row="1" Margin="0,10,0,8" Checked="Filter_Changed" Unchecked="Filter_Changed">
            <TextBlock x:Name="DayOnlyText" TextWrapping="Wrap"/>
        </CheckBox>
        <ListView x:Name="ExpensesList" Grid.Row="2" BorderBrush="#D8CEBC" MouseDoubleClick="ExpensesList_MouseDoubleClick"
                  SelectionChanged="ExpensesList_SelectionChanged" FontFamily="Segoe UI, Segoe UI Emoji">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Data" Width="82" DisplayMemberBinding="{Binding DateText}"/>
                    <GridViewColumn Header="Categoria" Width="120" DisplayMemberBinding="{Binding CategoryText}"/>
                    <GridViewColumn Header="Descrizione" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DescriptionText}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Importo" Width="86">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AmountText}" TextAlignment="Right" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Stato" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="📎" Width="32" DisplayMemberBinding="{Binding AttachmentMark}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="Aggiungi" Click="Add_Click" Padding="12,5" Margin="0,0,7,4"/>
            <Button x:Name="EditButton" Content="Modifica" Click="Edit_Click" Padding="12,5" Margin="0,0,7,4"/>
            <Button x:Name="DeleteButton" Content="Elimina" Click="Delete_Click" Padding="12,5" Margin="0,0,7,4"/>
            <Button x:Name="ToggleStatusButton" Content="Segna rimborsata" Click="ToggleStatus_Click" Padding="12,5" Margin="0,0,7,4"/>
            <Button x:Name="OpenAttachmentButton" Content="Apri allegato" Click="OpenAttachment_Click" Padding="12,5" Margin="0,0,7,4"/>
        </WrapPanel>
        <Border Grid.Row="4" Margin="0,8,0,0" Background="#F3EEE3" BorderBrush="#D8CEBC" BorderThickness="1" Padding="10" CornerRadius="3">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
        </Border>
        <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Apri cartella note spese" Click="OpenFolder_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Chiudi" MinWidth="90" Padding="12,6" IsCancel="True" Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</Window>
