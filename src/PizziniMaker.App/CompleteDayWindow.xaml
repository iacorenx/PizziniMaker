<Window x:Class="PizziniMaker.App.CompleteDayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PizziniMaker;component/Assets/PizziniMaker.ico"
        Title="Completare le ore?" Width="450" MinWidth="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FFF9EF" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="22">
        <TextBlock Text="Ore insufficienti" FontSize="21" FontWeight="SemiBold" Foreground="#8D3D12" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Margin="0,10,0,12" TextWrapping="Wrap"/>
        <TextBlock TextWrapping="Wrap" Foreground="#6C665B" Margin="0,0,0,14"
                   Text="Scegli l'attività con cui raggiungere 8 ore e chiudere il giorno, oppure annulla senza modificare la bozza."/>
        <Button Click="Qu_Click" Padding="10,7" Margin="0,0,0,7" HorizontalContentAlignment="Center"
                Background="#2F6F4E" Foreground="White" BorderBrush="#2F6F4E">
            <TextBlock Text="Completa e chiudi con QU" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button Click="Leave_Click" Padding="10,7" Margin="0,0,0,7" HorizontalContentAlignment="Center">
            <TextBlock Text="Completa e chiudi con FERIE/PERMESSO" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button Content="Annulla" IsCancel="True" Padding="12,5" HorizontalAlignment="Right" MinWidth="90"/>
    </StackPanel>
</Window>
